#!/bin/bash
# ABOUTME: Solve script. Copies the finished code in, then drives the whole
# retry conversation, because nothing else will.
#
# exercise7/StartWorkflow hardcodes invalid-account-456 and uses fire-and-forget
# WorkflowClient.start with no approval, so the Workflow parks in RETRYING and
# stays there. Unlike the other chapters, running the starter is not enough to
# satisfy the check: the two Signals below are what completes the transfer.
set -uo pipefail
export GRADLE_USER_HOME=/root/.gradle
cd /root/workshop || exit 0

SRC=src/main/java/com/temporal/training/solution7
DST=src/main/java/com/temporal/training/exercise7

for f in "$SRC"/*.java; do
    sed 's/^package com\.temporal\.training\.solution7;/package com.temporal.training.exercise7;/' \
        "$f" > "$DST/$(basename "$f")"
done

pkill -f "com.temporal.training.*StartWorker" 2>/dev/null || true
sleep 1

nohup ./gradlew --console=plain -q execute \
    -PmainClass=com.temporal.training.exercise7.StartWorker \
    > /tmp/solve-07-worker.log 2>&1 &
WORKER_PID=$!
sleep 20

timeout 180 ./gradlew --console=plain -q execute \
    -PmainClass=com.temporal.training.exercise7.StartWorkflow

# The starter prints nothing, so the id comes back off the server.
WF=""
for _ in $(seq 1 20); do
    WF=$(temporal workflow list \
        --query 'TaskQueue="money-transfer-task-queue" AND ExecutionStatus="Running"' \
        --limit 1 -o json 2>/dev/null | jq -r '.[0].execution.workflowId // empty')
    [ -n "$WF" ] && break
    sleep 2
done

if [ -z "$WF" ]; then
    echo "No running Workflow found on money-transfer-task-queue."
    pkill -f "com.temporal.training.exercise7.StartWorker" 2>/dev/null || true
    kill "$WORKER_PID" 2>/dev/null || true
    exit 0
fi
echo "Driving $WF"

# Withdraw has already succeeded against account-123. Approve, let the deposit
# fail against invalid-account-456, then hand it a valid account.
temporal workflow signal --workflow-id "$WF" --name approve --input true || true

for _ in $(seq 1 30); do
    STATUS=$(temporal workflow query --workflow-id "$WF" --type getStatus -o json 2>/dev/null \
        | jq -r '.queryResult[0] // empty')
    [ "$STATUS" = "RETRYING" ] && break
    sleep 2
done

temporal workflow signal --workflow-id "$WF" --name retry \
    --input '{"key":"toAccount","value":"account-456"}' || true

for _ in $(seq 1 30); do
    temporal workflow list \
        --query 'TaskQueue="money-transfer-task-queue" AND ExecutionStatus="Completed"' \
        --limit 1 2>/dev/null | grep -q "Completed" && break
    sleep 2
done

pkill -f "com.temporal.training.exercise7.StartWorker" 2>/dev/null || true
kill "$WORKER_PID" 2>/dev/null || true
exit 0
