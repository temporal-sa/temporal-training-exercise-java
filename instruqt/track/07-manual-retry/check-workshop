#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: TODOs gone from the two files the attendee edits.
# Gate 2: the non-retryable failure and the manual retry loop are both present,
#         and the module compiles.
# Gate 3: a Workflow completed on money-transfer-task-queue, which only happens
#         after the retry Signal lands with a corrected account.
export GRADLE_USER_HOME=/root/.gradle
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

EX=/root/workshop/src/main/java/com/temporal/training/exercise7

for f in BankingActivitiesImpl.java MoneyTransferWorkflowImpl.java; do
    if grep -q "TODO" "$EX/$f" 2>/dev/null; then
        fail "$f still has TODO comments. Implement them, then check again."
    fi
done
pass "All TODOs implemented"

if ! grep -q "newNonRetryableFailure" "$EX/BankingActivitiesImpl.java" 2>/dev/null; then
    fail "BankingActivitiesImpl.java never throws ApplicationFailure.newNonRetryableFailure(). Automatic retry will keep hammering the bad account."
fi
pass "Non-retryable failure thrown on invalid accounts"

if ! grep -q "Workflow.await" "$EX/MoneyTransferWorkflowImpl.java" 2>/dev/null; then
    fail "MoneyTransferWorkflowImpl.java never waits on a retry Signal. executeWithRetry needs a Workflow.await()."
fi
pass "Manual retry loop waits for the retry Signal"

cd /root/workshop || fail "Workshop directory is missing."
if ! OUT=$(./gradlew --console=plain -q classes 2>&1); then
    echo "$OUT" | tail -20
    fail "The project does not compile. Fix the errors above, then check again."
fi
pass "Project compiles"

COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="money-transfer-task-queue" AND ExecutionStatus="Completed"' \
    --limit 1 2>/dev/null | grep -c "Completed" || true)

if [ "$COMPLETED" -lt 1 ]; then
    fail "No completed Workflow on money-transfer-task-queue. Run the Worker and the starter, approve the transfer, then send the retry Signal with a valid account."
fi
pass "Transfer completed after the manual retry"
