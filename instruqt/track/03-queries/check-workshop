#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: TODOs gone from the three files the attendee edits.
# Gate 2: the Query method is annotated and the status actually moves.
# Gate 3: a money transfer Workflow completed.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

EX=/root/workshop/src/main/java/com/temporal/training/exercise3

for f in MoneyTransferWorkflow.java MoneyTransferWorkflowImpl.java StartWorkflow.java; do
    if grep -q "TODO" "$EX/$f" 2>/dev/null; then
        fail "$f still has TODO comments. Implement them, then check again."
    fi
done
pass "All TODOs implemented"

if ! grep -q "@QueryMethod" "$EX/MoneyTransferWorkflow.java" 2>/dev/null; then
    fail "MoneyTransferWorkflow.java has no @QueryMethod. getStatus() needs one to be callable as a Query."
fi
pass "@QueryMethod present"

for s in APPROVED COMPLETED CANCELLED; do
    if ! grep -q "status *= *TransferStatus\.$s" "$EX/MoneyTransferWorkflowImpl.java" 2>/dev/null; then
        fail "MoneyTransferWorkflowImpl.java never sets status to TransferStatus.$s."
    fi
done
pass "Status moves through APPROVED, COMPLETED and CANCELLED"

COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="MoneyTransferTaskQueue" AND WorkflowType="MoneyTransferWorkflow" AND ExecutionStatus="Completed"' \
    --limit 1 -o json 2>/dev/null | jq 'length')

if [ "${COMPLETED:-0}" -lt 1 ]; then
    fail "No completed money transfer Workflow. Start the Worker, run StartWorkflow, and wait for the result to print."
fi
pass "Money transfer Workflow completed"
