#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: TODOs gone. Gate 2: a Query handler is declared and it compiles.
# Gate 3: a Workflow completed on the exercise 3 task queue.
export GRADLE_USER_HOME=/root/.gradle
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

EX=/root/workshop/src/main/java/com/temporal/training/exercise3

for f in MoneyTransferWorkflow.java MoneyTransferWorkflowImpl.java StartWorkflow.java; do
    if grep -q "TODO" "$EX/$f" 2>/dev/null; then
        fail "$f still has TODO comments. Implement them, then check again."
    fi
done
pass "All TODOs implemented"

if ! grep -q "@QueryMethod" "$EX/MoneyTransferWorkflow.java" 2>/dev/null; then
    fail "MoneyTransferWorkflow.java has no @QueryMethod. getStatus() needs one on the interface."
fi
pass "Query handler declared"

cd /root/workshop || fail "Workshop directory is missing."
if ! OUT=$(./gradlew --console=plain -q classes 2>&1); then
    echo "$OUT" | tail -20
    fail "The project does not compile. Fix the errors above, then check again."
fi
pass "Project compiles"

COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="money-transfer-queries-task-queue" AND ExecutionStatus="Completed"' \
    --limit 1 2>/dev/null | grep -c "Completed" || true)

if [ "$COMPLETED" -lt 1 ]; then
    fail "No completed money transfer Workflow. Start the Worker, run StartWorkflow, and wait for the result to print."
fi
pass "Money transfer Workflow completed"
