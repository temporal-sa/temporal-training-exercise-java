#!/bin/bash
# ABOUTME: Per-challenge setup. Runs when the attendee enters this challenge.
#
# No staging here. The seven exercises are one Gradle project rooted at
# /root/workshop, provisioned and pre-compiled once by the sandbox preset.
# Per-challenge setup only clears Workers and starters left over from a prior
# chapter. Each pattern matches both the ./gradlew client and the JVM it forks.
set -euo pipefail

pkill -f "StartWorker"   2>/dev/null || true
pkill -f "StartWorkflow" 2>/dev/null || true

echo "Exercise 2 ready."
