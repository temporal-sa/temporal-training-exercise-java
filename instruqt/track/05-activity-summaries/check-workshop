#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: TODOs gone from both files.
# Gate 2: setSummary and setStaticSummary are both called.
# Gate 3: a completed transfer actually carries the metadata on the server:
#         a summary on WorkflowExecutionStarted (the static summary) and on
#         at least two ActivityTaskScheduled events (withdraw and deposit).
#         Gate 2 alone would pass on a summary that never reached the stub.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

EX=/root/workshop/src/main/java/com/temporal/training/exercise5

for f in MoneyTransferWorkflowImpl.java StartWorkflow.java; do
    if grep -q "TODO" "$EX/$f" 2>/dev/null; then
        fail "$f still has TODO comments. Implement them, then check again."
    fi
done
pass "All TODOs implemented"

if ! grep -q "setSummary" "$EX/MoneyTransferWorkflowImpl.java" 2>/dev/null; then
    fail "MoneyTransferWorkflowImpl.java never calls setSummary() on the ActivityOptions."
fi
pass "Activity summaries set"

if ! grep -q "setStaticSummary" "$EX/StartWorkflow.java" 2>/dev/null; then
    fail "StartWorkflow.java never calls setStaticSummary() on the WorkflowOptions."
fi
pass "Static summary set"

IDS=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="MoneyTransferTaskQueue" AND WorkflowType="MoneyTransferWorkflow" AND ExecutionStatus="Completed"' \
    --limit 10 -o json 2>/dev/null | jq -r '.[].execution.workflowId')

if [ -z "$IDS" ]; then
    fail "No completed money transfer Workflow. Start the Worker, run StartWorkflow, and wait for the result to print."
fi
pass "Money transfer Workflow completed"

for id in $IDS; do
    if temporal workflow show --address 127.0.0.1:7233 --workflow-id "$id" -o json 2>/dev/null \
        | jq -e '
            any(.events[]; .eventType == "EVENT_TYPE_WORKFLOW_EXECUTION_STARTED" and .userMetadata.summary != null)
            and ([.events[] | select(.eventType == "EVENT_TYPE_ACTIVITY_TASK_SCHEDULED" and .userMetadata.summary != null)] | length >= 2)
          ' >/dev/null; then
        pass "Static and Activity summaries recorded in the history of $id"
        exit 0
    fi
done
fail "No completed transfer carries both a static summary and Activity summaries yet. Restart the Worker so it picks up your changes, run StartWorkflow again, then check."
