#!/bin/bash
# ABOUTME: Per-challenge cleanup. Kill the Worker and the starter.
# One pattern per line: macOS pkill does not support alternation. Each
# pattern matches both the ./gradlew client and the JVM it forks; the Gradle
# daemon itself is left running for the next chapter.
set -euo pipefail

pkill -f "StartWorker"   2>/dev/null || true
pkill -f "StartWorkflow" 2>/dev/null || true
sleep 1

echo "Exercise 5 cleanup: OK"
